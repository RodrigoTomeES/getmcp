---
/**
 * 404 content: ASCII "404", a fake terminal and a link back to /servers.
 * Rendered statically. The solid ASCII layer is revealed by a CSS `clip-path`
 * wipe (`motion-safe:animate-ascii-reveal`); the scanline sweep and the
 * cursor blink are also motion-safe only. The 404 page is a single static
 * file, so the requested path is only known in the browser: the script below
 * writes it into `[data-pathname]` (the HTML shows "/unknown").
 */

// prettier-ignore
const asciiArt =
`██╗  ██╗ ██████╗ ██╗  ██╗
██║  ██║██╔═══██╗██║  ██║
███████║██║   ██║███████║
╚════██║██║   ██║╚════██║
     ██║╚██████╔╝     ██║
     ╚═╝ ╚═════╝      ╚═╝`;
const solidArt = asciiArt.replace(/[╗╔╚╝═║]/g, " ");

const asciiFont = "font-size: clamp(10px, 4.2vw, 26px)";
---

<div
  class="max-w-6xl mx-auto px-6 py-20 flex flex-col items-center justify-center"
  style="min-height: calc(100dvh - 57px - 85px)"
>
  {/* Static CRT scanlines */}
  <div
    class="pointer-events-none fixed inset-0 z-10"
    style="background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(255,255,255,0.015) 2px, rgba(255,255,255,0.015) 4px)"
    aria-hidden="true"
  >
  </div>

  {/* Sweeping scanline — hidden for reduced motion */}
  <div
    class="pointer-events-none fixed left-0 right-0 z-10 h-0.5 motion-reduce:hidden"
    style="background: linear-gradient(90deg, transparent, rgba(59, 130, 246, 0.07), transparent); animation: scanline-sweep 8s linear infinite"
    aria-hidden="true"
  >
  </div>

  {/* ASCII 404 */}
  <div class="relative mb-10 sm:mb-14" aria-hidden="true">
    <pre
      class="font-mono tracking-[-1px] leading-[125%] whitespace-pre select-none text-center"
      style={`${asciiFont}; color: lab(59.4% 0 0)`}
      aria-hidden="true">{asciiArt}</pre>
    <pre
      class="absolute top-0 left-0 w-full font-mono tracking-[-1px] leading-[125%] whitespace-pre select-none text-center text-text motion-safe:animate-ascii-reveal"
      style={`${asciiFont}; text-shadow: 0 0 20px rgba(59, 130, 246, 0.3), 0 0 40px rgba(59, 130, 246, 0.1)`}
      aria-hidden="true">{solidArt}</pre>
  </div>

  {/* Terminal window */}
  <div class="w-full max-w-lg">
    <div class="rounded-lg border border-border overflow-hidden">
      <div class="flex items-center gap-2 px-4 py-2.5 border-b border-border bg-code-bg">
        <div class="flex gap-1.5" aria-hidden="true">
          <span class="block w-3 h-3 rounded-full bg-[#ff5f57]/80"></span>
          <span class="block w-3 h-3 rounded-full bg-[#febc2e]/80"></span>
          <span class="block w-3 h-3 rounded-full bg-[#28c840]/80"></span>
        </div>
        <span class="text-xs font-mono text-text-secondary/60 ml-2">terminal</span>
      </div>

      <div class="p-4 font-mono text-[13px] leading-relaxed bg-surface">
        <div class="text-text">$ npx @getmcp/cli find <span data-pathname>/unknown</span></div>
        <div>&nbsp;</div>
        <div class="text-red-400">Error: resource not found in registry.</div>
        <div>&nbsp;</div>
        <div class="text-text-secondary">
          hint: try "npx @getmcp/cli list" to browse all servers
        </div>
        <div class="mt-1 flex items-center text-text">
          <span>$ </span>
          <span
            class="inline-block w-[0.55em] h-[1.1em] bg-text/70 align-middle motion-safe:animate-[blink_1s_step-end_infinite] ml-0.5"
          ></span>
        </div>
      </div>
    </div>
  </div>

  {/* CTA */}
  <div class="mt-10 text-center">
    <a
      href="/servers"
      class="inline-block px-6 py-2.5 rounded-lg bg-accent text-white font-medium hover:bg-accent-hover transition-colors"
    >
      Browse servers
    </a>
    <p class="text-xs text-text-secondary mt-3 font-mono">
      or run <code class="px-1.5 py-0.5 rounded bg-code-bg text-text">npx @getmcp/cli find</code>
    </p>
  </div>
</div>

<script>
  const el = document.querySelector("[data-pathname]");
  if (el) el.textContent = location.pathname;
</script>
