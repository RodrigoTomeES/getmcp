---
/**
 * /docs table of contents. The scroll-spy rules live in
 * `public/docs-scroll-spy.css`, linked from `pages/docs.astro`
 * (see .agents/docs/css-scroll-spy.md).
 */
const sections = [
  { id: "what-is-getmcp", label: "What is getmcp?", level: 2 },
  { id: "getting-started", label: "Getting started", level: 2 },
  { id: "project-manifests", label: "Project manifests", level: 2 },
  { id: "custom-registries", label: "Custom registries", level: 2 },
  { id: "adding-a-registry", label: "Adding a registry", level: 3 },
  { id: "listing-registries", label: "Listing registries", level: 3 },
  { id: "removing-a-registry", label: "Removing a registry", level: 3 },
  { id: "using-a-specific-registry", label: "Using a specific registry", level: 3 },
  { id: "authentication", label: "Authentication", level: 2 },
  { id: "login", label: "Login", level: 3 },
  { id: "logout", label: "Logout", level: 3 },
  { id: "env-var-override", label: "Env variable override", level: 3 },
  { id: "credential-storage", label: "Credential storage", level: 3 },
  { id: "supported-apps", label: "Supported apps", level: 2 },
  { id: "how-it-works", label: "How it works", level: 2 },
  { id: "library-usage", label: "Library usage", level: 2 },
  { id: "generate-config", label: "Generate config", level: 3 },
  { id: "validate-schemas", label: "Validate schemas", level: 3 },
  { id: "search-registry", label: "Search registry", level: 3 },
  { id: "adding-a-server", label: "Adding a server", level: 2 },
  { id: "security-disclaimer", label: "Security disclaimer", level: 2 },
] as const;
---

<nav aria-label="Table of contents" class="hidden lg:block sticky top-6 w-48 shrink-0 self-start">
  <p class="text-xs font-medium uppercase tracking-wider text-text-secondary mb-4">On this page</p>
  <ul class="space-y-2.5 text-sm border-l border-border pl-4">
    {
      sections.map((section) => (
        <li>
          <a
            href={`#${section.id}`}
            class={`block transition-colors text-text-secondary hover:text-text ${
              section.level === 3 ? "pl-3 text-xs" : ""
            }`}
          >
            {section.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
