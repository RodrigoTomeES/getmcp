---
/**
 * Server page sidebar: stats, details, links and tags. Renders nothing when
 * the server has no data for any section.
 */
import type { InternalRegistryEntry } from "@getmcp/registry";
import { getServerMetrics } from "@getmcp/registry";
import CircleDot from "@lucide/astro/icons/circle-dot";
import Download from "@lucide/astro/icons/download";
import ExternalLink from "@lucide/astro/icons/external-link";
import GitFork from "@lucide/astro/icons/git-fork";
import Star from "@lucide/astro/icons/star";
import { compactNumber, relativeTime } from "@/lib/format";

type Metrics = NonNullable<ReturnType<typeof getServerMetrics>>;

interface Props {
  server: InternalRegistryEntry;
  metrics?: Metrics;
}

const { server, metrics } = Astro.props;

function extractDomain(url: string): string {
  try {
    return new URL(url).hostname.replace("www.", "");
  } catch {
    return url;
  }
}

// Brand icons from simple-icons (CC0), inlined as path data.
const GITHUB_PATH =
  "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12";
const DOCKER_PATH =
  "M13.983 11.078h2.119a.186.186 0 00.186-.185V9.006a.186.186 0 00-.186-.186h-2.119a.185.185 0 00-.185.185v1.888c0 .102.083.185.185.185m-2.954-5.43h2.118a.186.186 0 00.186-.186V3.574a.186.186 0 00-.186-.185h-2.118a.185.185 0 00-.185.185v1.888c0 .102.082.185.185.185m0 2.716h2.118a.187.187 0 00.186-.186V6.29a.186.186 0 00-.186-.185h-2.118a.185.185 0 00-.185.185v1.887c0 .102.082.185.185.186m-2.93 0h2.12a.186.186 0 00.184-.186V6.29a.185.185 0 00-.185-.185H8.1a.185.185 0 00-.185.185v1.887c0 .102.083.185.185.186m-2.964 0h2.119a.186.186 0 00.185-.186V6.29a.185.185 0 00-.185-.185H5.136a.186.186 0 00-.186.185v1.887c0 .102.084.185.186.186m5.893 2.715h2.118a.186.186 0 00.186-.185V9.006a.186.186 0 00-.186-.186h-2.118a.185.185 0 00-.185.185v1.888c0 .102.082.185.185.185m-2.93 0h2.12a.185.185 0 00.184-.185V9.006a.185.185 0 00-.184-.186h-2.12a.185.185 0 00-.184.185v1.888c0 .102.083.185.185.185m-2.964 0h2.119a.185.185 0 00.185-.185V9.006a.185.185 0 00-.184-.186h-2.12a.186.186 0 00-.186.186v1.887c0 .102.084.185.186.185m-2.92 0h2.12a.185.185 0 00.184-.185V9.006a.185.185 0 00-.184-.186h-2.12a.185.185 0 00-.184.185v1.888c0 .102.082.185.185.185M23.763 9.89c-.065-.051-.672-.51-1.954-.51-.338.001-.676.03-1.01.087-.248-1.7-1.653-2.53-1.716-2.566l-.344-.199-.226.327c-.284.438-.49.922-.612 1.43-.23.97-.09 1.882.403 2.661-.595.332-1.55.413-1.744.42H.751a.751.751 0 00-.75.748 11.376 11.376 0 00.692 4.062c.545 1.428 1.355 2.48 2.41 3.124 1.18.723 3.1 1.137 5.275 1.137.983.003 1.963-.086 2.93-.266a12.248 12.248 0 003.823-1.389c.98-.567 1.86-1.288 2.61-2.136 1.252-1.418 1.998-2.997 2.553-4.4h.221c1.372 0 2.215-.549 2.68-1.009.309-.293.55-.65.707-1.046l.098-.288Z";

const downloads = metrics?.npm?.weeklyDownloads ?? metrics?.pypi?.weeklyDownloads;
const downloadLabel = downloads != null ? "/week" : "";
const version = metrics?.npm?.latestVersion ?? metrics?.pypi?.latestVersion ?? server.version;
const isRemote = "url" in server.config;

type Stat = { Icon: typeof Star | "docker"; label: string; value: string };
const stats: Stat[] = [];
if (metrics?.github?.stars != null && metrics.github.stars > 0) {
  stats.push({ Icon: Star, label: "Stars", value: compactNumber(metrics.github.stars) });
}
if (metrics?.github?.forks != null && metrics.github.forks > 0) {
  stats.push({ Icon: GitFork, label: "Forks", value: compactNumber(metrics.github.forks) });
}
if (downloads != null && downloads > 0) {
  stats.push({
    Icon: Download,
    label: `Downloads${downloadLabel}`,
    value: compactNumber(downloads),
  });
}
if (metrics?.github?.openIssues != null && metrics.github.openIssues > 0) {
  stats.push({
    Icon: CircleDot,
    label: "Open Issues",
    value: compactNumber(metrics.github.openIssues),
  });
}
if (metrics?.docker?.pulls != null && metrics.docker.pulls > 0) {
  stats.push({ Icon: "docker", label: "Docker Pulls", value: compactNumber(metrics.docker.pulls) });
}
const hasStats = stats.length > 0;

const details: Array<{ label: string; value: string; mono?: boolean }> = [];
if (server.isOfficial) details.push({ label: "Status", value: "Official" });
if (server.author) details.push({ label: "Author", value: server.author });
if (version) details.push({ label: "Version", value: version, mono: true });
if (server.license) details.push({ label: "License", value: server.license });
if (server.runtime) details.push({ label: "Runtime", value: server.runtime });
if (server.language) details.push({ label: "Language", value: server.language });
if (server.package) details.push({ label: "Package", value: server.package, mono: true });
details.push({ label: "Transport", value: isRemote ? "Remote" : "Stdio" });
if (metrics?.github?.lastPush) {
  details.push({ label: "Updated", value: relativeTime(metrics.github.lastPush) });
}

const hasLinks = server.repository || server.homepage;
const maxTags = 10;
const tags = server.tags ?? [];
const visibleTags = tags.slice(0, maxTags);
const hiddenCount = tags.length - maxTags;

const hasSections = hasStats || details.length > 0 || hasLinks || visibleTags.length > 0;
---

{
  hasSections && (
    <div
      class="rounded-lg border border-border bg-surface divide-y divide-border"
      aria-label="Server metadata"
    >
      {/* Stats grid */}
      {hasStats && (
        <div class="p-5">
          <div class="grid grid-cols-2 gap-4">
            {stats.map(({ Icon, label, value }) => (
              <div>
                <p class="text-xs text-text-secondary mb-1">{label}</p>
                <p class="text-sm font-semibold flex items-center gap-1.5">
                  <span class="text-text-secondary">
                    {Icon === "docker" ? (
                      <svg
                        viewBox="0 0 24 24"
                        class="w-4 h-4"
                        aria-hidden="true"
                        fill="currentColor"
                      >
                        <path d={DOCKER_PATH} />
                      </svg>
                    ) : (
                      <Icon class="w-4 h-4" aria-hidden="true" />
                    )}
                  </span>
                  {value}
                </p>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* Details */}
      {details.length > 0 && (
        <div class="p-5 space-y-3">
          {details.map((d) => (
            <div class="flex items-center justify-between gap-4">
              <span class="text-xs text-text-secondary shrink-0">{d.label}</span>
              <span class="text-sm text-text truncate text-right">
                <span class={d.mono ? "font-mono" : ""} title={d.value}>{d.value}</span>
              </span>
            </div>
          ))}
        </div>
      )}

      {/* Links */}
      {hasLinks && (
        <div class="p-5 space-y-2">
          {server.repository && (
            <a
              href={server.repository}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-sm text-accent hover:underline transition-colors"
            >
              <svg viewBox="0 0 24 24" class="w-4 h-4" aria-hidden="true" fill="currentColor">
                <path d={GITHUB_PATH} />
              </svg>
              <span class="truncate">{extractDomain(server.repository)}</span>
              <span class="sr-only"> (opens in new tab)</span>
            </a>
          )}
          {server.homepage && server.homepage !== server.repository && (
            <a
              href={server.homepage}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-sm text-accent hover:underline transition-colors"
            >
              <ExternalLink class="w-4 h-4" aria-hidden="true" />
              <span class="truncate">{extractDomain(server.homepage)}</span>
              <span class="sr-only"> (opens in new tab)</span>
            </a>
          )}
        </div>
      )}

      {/* Tags */}
      {visibleTags.length > 0 && (
        <div class="p-5">
          <p class="text-xs font-medium uppercase tracking-wider text-text-secondary mb-2">Tags</p>
          <div class="flex flex-wrap gap-1.5" aria-label="Server tags">
            {visibleTags.map((tag) => (
              <span class="text-xs px-2 py-0.5 rounded-full bg-tag-bg text-tag-text">{tag}</span>
            ))}
            {hiddenCount > 0 && (
              <span class="text-xs px-2 py-0.5 rounded-full bg-surface-hover text-text-secondary">
                +{hiddenCount} more
              </span>
            )}
          </div>
        </div>
      )}
    </div>
  )
}
