---
const FEATURES = [
  "Masked prompts for secrets",
  "HTTPS enforcement for registries",
  "Merge-only config writes",
  "Credential management with env overrides",
  "Atomic file operations",
  "Prototype pollution prevention",
];
---

<section class="mb-12">
  <h2 class="text-xl font-bold mb-2">Security by default</h2>
  <p class="text-text-secondary mb-8 max-w-2xl">
    Your secrets stay secret. Your configs stay safe.
  </p>

  <div class="rounded-lg border border-border bg-surface p-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {
        FEATURES.map((feature) => (
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-success shrink-0" aria-hidden="true" />
            <span class="text-sm text-text-secondary">{feature}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
