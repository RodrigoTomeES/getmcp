---
import { Font } from "astro:assets";
import "@/styles/globals.css";
import { absoluteUrl, type ResolvedMetadata } from "@/lib/metadata";
import { OG_SIZE } from "@/lib/og-image";

interface Props {
  metadata: ResolvedMetadata;
  /** Preload the box-drawing font subset (pages with an above-the-fold ASCII logo). */
  preloadSymbols?: boolean;
}

const { metadata, preloadSymbols = false } = Astro.props;
const fontPreload = [
  { weight: 400, style: "normal", subset: "latin" },
  ...(preloadSymbols ? [{ weight: 400, style: "normal", subset: "symbols2" }] : []),
];
const { title, description, alternates, openGraph, twitter, ogImage, noindex } =
  metadata;
const ogImageUrl = ogImage && absoluteUrl(ogImage.path);

// Cloudflare Web Analytics beacon (replaces Vercel Analytics + Speed Insights).
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
---

<!doctype html>
<html lang="en" style="color-scheme: dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0a" />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex" />}
    {description && <meta name="description" content={description} />}
    {alternates?.canonical && <link rel="canonical" href={absoluteUrl(alternates.canonical)} />}
    {openGraph?.title && <meta property="og:title" content={openGraph.title} />}
    {
      alternates?.canonical && (
        <meta property="og:url" content={absoluteUrl(alternates.canonical)} />
      )
    }
    {openGraph?.description && <meta property="og:description" content={openGraph.description} />}
    {openGraph?.siteName && <meta property="og:site_name" content={openGraph.siteName} />}
    {openGraph?.locale && <meta property="og:locale" content={openGraph.locale} />}
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImageUrl} />
          <meta property="og:image:alt" content={ogImage.alt} />
          <meta property="og:image:type" content="image/png" />
          <meta property="og:image:width" content={String(OG_SIZE.width)} />
          <meta property="og:image:height" content={String(OG_SIZE.height)} />
        </>
      )
    }
    {openGraph?.type && <meta property="og:type" content={openGraph.type} />}
    {twitter?.card && <meta name="twitter:card" content={twitter.card} />}
    {twitter?.site && <meta name="twitter:site" content={twitter.site} />}
    {twitter?.creator && <meta name="twitter:creator" content={twitter.creator} />}
    {twitter?.title && <meta name="twitter:title" content={twitter.title} />}
    {twitter?.description && <meta name="twitter:description" content={twitter.description} />}
    {
      ogImage && (
        <>
          <meta name="twitter:image" content={ogImageUrl} />
          <meta name="twitter:image:alt" content={ogImage.alt} />
        </>
      )
    }
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <Font cssVariable="--font-fira-mono" preload={fontPreload} />
    <slot name="head" />
  </head>
  <body class="min-h-dvh flex flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:rounded-lg focus:bg-accent focus:text-white focus:text-sm focus:font-medium"
    >
      Skip to main content
    </a>

    <header class="border-b border-border px-6 py-4">
      <div class="max-w-6xl mx-auto flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
        <a href="/" class="flex items-center gap-2.5" aria-label="getmcp home">
          <img
            src="/icon.svg"
            alt=""
            width="32"
            height="32"
            class="h-6 w-auto"
          />
          <span class="text-xl font-bold tracking-tight -mt-1.5">getmcp</span>
          <span class="max-sm:hidden text-xs px-2 py-0.5 rounded-full bg-accent text-white font-medium">
            beta
          </span>
        </a>
        <nav class="flex items-center gap-3 sm:gap-6 text-sm">
          <a href="/servers" class="text-text-secondary hover:text-text transition-colors">
            Servers
          </a>
          <a href="/guides" class="text-text-secondary hover:text-text transition-colors">
            Guides
          </a>
          <a href="/docs" class="text-text-secondary hover:text-text transition-colors">Docs</a>
          <a
            href="https://github.com/RodrigoTomeES/getmcp"
            target="_blank"
            rel="noopener noreferrer"
            class="text-text-secondary hover:text-text transition-colors"
          >
            GitHub
            <span class="sr-only"> (opens in new tab)</span>
          </a>
        </nav>
      </div>
    </header>

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-border px-6 py-8 text-sm text-text-secondary">
      <div class="max-w-6xl mx-auto">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-4">
          <p>getmcp &mdash; One config format, every AI app.</p>
          <nav class="flex items-center gap-4">
            <a href="/servers" class="hover:text-text transition-colors">Servers</a>
            <a href="/guides" class="hover:text-text transition-colors">Guides</a>
            <a href="/docs" class="hover:text-text transition-colors">Docs</a>
            <a
              href="https://github.com/RodrigoTomeES/getmcp"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-text transition-colors"
            >
              GitHub
              <span class="sr-only"> (opens in new tab)</span>
            </a>
          </nav>
        </div>
        <p class="text-xs text-text-secondary/60 text-center">&copy; 2026 getmcp</p>
      </div>
    </footer>

    {
      analyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: analyticsToken })}
        />
      )
    }
  </body>
</html>
