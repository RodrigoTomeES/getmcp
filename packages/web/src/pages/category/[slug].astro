---
import type { GetStaticPaths } from "astro";
import { getServersByCategory } from "@getmcp/registry";
import BaseLayout from "@/layouts/BaseLayout.astro";
import JsonLd from "@/components/JsonLd.astro";
import ServerCard from "@/components/ServerCard.astro";
import { CATEGORY_NAMES, CATEGORY_DESCRIPTIONS, CATEGORY_SLUGS } from "@/lib/categories";
import { APP_COUNT, SITE_URL } from "@/lib/constants";
import { resolveMetadata } from "@/lib/metadata";
import type { ServerCardData } from "@/lib/server-detail";
import { CATEGORY_OG } from "@/lib/og-pages";

// Only categories with a display name get a page.
export const getStaticPaths = (() =>
  CATEGORY_SLUGS.map((slug) => ({ params: { slug } }))) satisfies GetStaticPaths;

const { slug } = Astro.params as { slug: string };
const name = CATEGORY_NAMES[slug];
const description = CATEGORY_DESCRIPTIONS[slug] ?? "";
const servers = getServersByCategory(slug);

const metaDescription = CATEGORY_DESCRIPTIONS[slug] ?? `Browse ${name} MCP servers.`;
const metadata = resolveMetadata(
  {
    title: `${name} MCP Servers — Browse & Install`,
    description: `${metaDescription} ${servers.length} servers available. Install with one command across ${APP_COUNT} AI apps.`,
    keywords: [name, `${name} MCP`, `${name} MCP servers`, "MCP server", "getmcp"],
    alternates: {
      canonical: `/category/${slug}`,
    },
    openGraph: {
      title: `${name} MCP Servers — getmcp`,
      description: `${metaDescription} Install with one command across ${APP_COUNT} AI apps.`,
      type: "website",
    },
    twitter: {
      card: "summary_large_image",
      title: `${name} MCP Servers — getmcp`,
      description: `${metaDescription} Install with one command across ${APP_COUNT} AI apps.`,
    },
  },
  { ogImage: { path: `/category/${slug}/opengraph-image.png`, alt: CATEGORY_OG.alt } },
);

const minimalServers: ServerCardData[] = servers.map((s) => ({
  id: s.id,
  slug: s.slug,
  name: s.name,
  description: s.description,
  categories: s.categories,
  isRemote: "url" in s.config,
  envCount: s.requiredEnvVars.length,
  isOfficial: s.isOfficial,
}));

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: `${name} MCP Servers`,
    description,
    url: `${SITE_URL}/category/${slug}`,
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": `${SITE_URL}/category/${slug}`,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: `${name} MCP Servers`,
    numberOfItems: servers.length,
    itemListElement: minimalServers.map((s, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: s.name,
      url: `${SITE_URL}/servers/${s.slug}`,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE_URL },
      { "@type": "ListItem", position: 2, name: "Servers", item: `${SITE_URL}/servers` },
      {
        "@type": "ListItem",
        position: 3,
        name,
        item: `${SITE_URL}/category/${slug}`,
      },
    ],
  },
];
---

<BaseLayout metadata={metadata}>
  <div class="max-w-6xl mx-auto px-6 py-10 md:py-16">
    <JsonLd data={jsonLd} />

    {/* Breadcrumb */}
    <nav class="text-sm text-text-secondary mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-text transition-colors">Home</a>
      <span class="mx-2 text-text-secondary/50">/</span>
      <a href="/servers" class="hover:text-text transition-colors">Servers</a>
      <span class="mx-2 text-text-secondary/50">/</span>
      <span class="text-text">{name}</span>
    </nav>

    {/* Header */}
    <div class="mb-10">
      <h1 class="text-3xl font-bold tracking-tight mb-3">{name} MCP Servers</h1>
      <p class="text-lg text-text-secondary leading-relaxed max-w-2xl">{description}</p>
      <p class="text-sm text-text-secondary mt-2">
        {servers.length} server{servers.length !== 1 ? "s" : ""} available
      </p>
    </div>

    {/* Server grid */}
    {
      minimalServers.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {minimalServers.map((server) => (
            <ServerCard server={server} />
          ))}
        </div>
      ) : (
        <div class="text-center py-20 text-text-secondary">
          <p class="text-lg mb-2">No servers in this category yet</p>
          <p class="text-sm">
            Check back soon or{" "}
            <a href="/servers" class="text-accent hover:underline">browse all servers</a>.
          </p>
        </div>
      )
    }
  </div>
</BaseLayout>
