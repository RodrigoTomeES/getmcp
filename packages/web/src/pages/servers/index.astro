---
import { getAllServers, getCategories } from "@getmcp/registry";
import BaseLayout from "@/layouts/BaseLayout.astro";
import JsonLd from "@/components/JsonLd.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { SearchBar } from "@/components/SearchBar";
import { APP_COUNT, SITE_URL } from "@/lib/constants";
import { resolveMetadata } from "@/lib/metadata";
import { toServerCardData } from "@/lib/server-detail";
import { DEFAULT_PAGE_SIZE, DEFAULT_SORT, sortServers } from "@/lib/server-search";
import { SERVERS_OG } from "@/lib/og-pages";

const metadata = resolveMetadata(
  {
    title: "MCP Server Directory — Browse & Install",
    description:
      `Browse and install MCP servers for Claude Desktop, VS Code, Cursor, and ${APP_COUNT - 3} more AI apps. Filter by category, search by name, and install with one command.`,
    alternates: {
      canonical: "/servers",
    },
    openGraph: {
      title: "MCP Server Directory — getmcp",
      description:
        `Browse and install MCP servers for Claude Desktop, VS Code, Cursor, and ${APP_COUNT - 3} more AI apps.`,
      type: "website",
    },
    twitter: {
      card: "summary_large_image",
      title: "MCP Server Directory — getmcp",
      description:
        `Browse and install MCP servers for Claude Desktop, VS Code, Cursor, and ${APP_COUNT - 3} more AI apps.`,
    },
  },
  { ogImage: { path: "/servers/opengraph-image.png", alt: SERVERS_OG.alt } },
);

const servers = getAllServers();
const categories = getCategories();
const count = servers.length;
// Only the first page ships as props; the island fetches the full index from /servers.json.
const initialServers = sortServers(servers.map(toServerCardData), DEFAULT_SORT).slice(
  0,
  DEFAULT_PAGE_SIZE,
);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "MCP Server Directory",
    description: `Browse and install ${count}+ MCP servers for ${APP_COUNT} AI applications.`,
    url: `${SITE_URL}/servers`,
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": `${SITE_URL}/servers`,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: SITE_URL,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Servers",
        item: `${SITE_URL}/servers`,
      },
    ],
  },
];
---

<BaseLayout metadata={metadata}>
  <div class="max-w-6xl mx-auto px-6 py-10 md:py-16">
    <JsonLd data={jsonLd} />

    <Breadcrumbs class="mb-8" items={[{ label: "Home", href: "/" }, { label: "Servers" }]} />

    {/* Header */}
    <div class="mb-12">
      <h1 class="text-4xl font-bold tracking-tight mb-3">MCP Server Directory</h1>
      <p class="text-lg text-text-secondary leading-relaxed max-w-2xl">
        Browse {count}+ MCP servers and install them into {APP_COUNT} AI applications with a single command.
      </p>
    </div>

    {/* Search + server listing */}
    <SearchBar client:load initialServers={initialServers} total={count} categories={categories} />
  </div>
</BaseLayout>
