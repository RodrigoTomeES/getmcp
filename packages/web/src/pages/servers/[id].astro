---
import type { GetStaticPaths } from "astro";
import type { InternalRegistryEntry } from "@getmcp/registry";
import { getServerMetrics } from "@getmcp/registry";
import BadgeCheck from "@lucide/astro/icons/badge-check";
import Lock from "@lucide/astro/icons/lock";
import BaseLayout from "@/layouts/BaseLayout.astro";
import JsonLd from "@/components/JsonLd.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ConfigViewer from "@/components/ConfigViewer.astro";
import PackageManagerCommand from "@/components/PackageManagerCommand.astro";
import ServerCard from "@/components/ServerCard.astro";
import ServerSidebar from "@/components/ServerSidebar.astro";
import { GUIDE_SLUGS } from "@/lib/guide-data";
import { SITE_URL } from "@/lib/constants";
import { toSentence } from "@/lib/format";
import { resolveMetadata } from "@/lib/metadata";
import { SERVER_OG_ALT } from "@/lib/og-server";
import { getServerPaths } from "@/lib/server-paths";
import { getRelatedServers, preGenerateConfigs, runtimeToRequirements } from "@/lib/server-detail";

export const getStaticPaths = (() => getServerPaths()) satisfies GetStaticPaths;

interface Props {
  server: InternalRegistryEntry;
}

const { server } = Astro.props;
const id = server.slug;

const title = `${server.name} MCP Server`;
const description = `${toSentence(server.description)} Install with: npx @getmcp/cli add ${server.id}`;

const metadata = resolveMetadata(
  {
    title,
    description,
    alternates: {
      canonical: `/servers/${id}`,
    },
    openGraph: {
      title: `${server.name} MCP Server — getmcp`,
      description,
      type: "website",
    },
    twitter: {
      card: "summary_large_image",
      title: `${server.name} MCP Server — getmcp`,
      description,
    },
  },
  { ogImage: { path: `/servers/${id}/opengraph-image.png`, alt: SERVER_OG_ALT } },
);

const configs = preGenerateConfigs(server.id, server.config);
const metrics = getServerMetrics(server.id);
const relatedServers = getRelatedServers(server);

const isRemote = "url" in server.config;
const transport = isRemote ? "remote" : "stdio";
const version = metrics?.npm?.latestVersion ?? metrics?.pypi?.latestVersion ?? server.version;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: `${server.name} MCP Server`,
    description: server.description,
    applicationCategory: "DeveloperApplication",
    applicationSubCategory: "MCP Server",
    operatingSystem: "Windows, macOS, Linux",
    softwareRequirements: runtimeToRequirements(server.runtime),
    ...(version && { softwareVersion: version }),
    isAccessibleForFree: true,
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
    },
    ...(server.author && {
      author: { "@type": "Organization", name: server.author },
    }),
    url: `${SITE_URL}/servers/${server.slug}`,
    ...(server.repository && { downloadUrl: server.repository }),
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": `${SITE_URL}/servers/${server.slug}`,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: SITE_URL,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Servers",
        item: `${SITE_URL}/servers`,
      },
      {
        "@type": "ListItem",
        position: 3,
        name: server.name,
        item: `${SITE_URL}/servers/${server.slug}`,
      },
    ],
  },
];
---

<BaseLayout metadata={metadata}>
  <div class="max-w-6xl mx-auto px-6 py-12">
    <JsonLd data={jsonLd} />

    <Breadcrumbs
      class="mb-10"
      items={[
        { label: "Home", href: "/" },
        { label: "Servers", href: "/servers" },
        { label: server.name },
      ]}
    />

    {/* Hero */}
    <section class="mb-10">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        {
          server.icons?.[0]?.src && (
            <img
              src={server.icons[0].src}
              alt={`${server.name} icon`}
              width="48"
              height="48"
              decoding="async"
              class="w-12 h-12 rounded-lg shrink-0"
            />
          )
        }
        <h1 class="text-3xl font-bold tracking-tight inline-flex items-baseline gap-1">
          {server.name}
          {
            server.isOfficial && (
              <span role="img" aria-label="Official MCP server" title="Official MCP server">
                <BadgeCheck class="h-[1ch] text-official shrink-0" aria-hidden="true" />
              </span>
            )
          }
        </h1>
        <span
          class:list={[
            "text-xs px-2 py-0.5 rounded-full font-medium shrink-0",
            isRemote
              ? "bg-transport-remote-bg text-transport-remote"
              : "bg-transport-stdio-bg text-transport-stdio",
          ]}
        >
          {transport}
        </span>
        {
          metrics?.github?.archived && (
            <span class="text-xs px-2 py-0.5 rounded-full bg-warning-bg text-warning font-medium shrink-0">
              Archived
            </span>
          )
        }
      </div>

      <p class="text-lg text-text-secondary leading-relaxed max-w-3xl mb-5">
        {server.description}
      </p>

      {/* Categories */}
      {
        server.categories && server.categories.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {server.categories.map((cat) => (
              <a
                href={`/category/${cat}`}
                class="text-xs px-3 py-1 rounded-full bg-tag-bg text-tag-text hover:bg-tag-bg/80 transition-colors"
              >
                {cat}
              </a>
            ))}
          </div>
        )
      }
    </section>

    {/* Two-column layout */}
    <div class="flex flex-col lg:flex-row gap-8 lg:gap-12">
      {/* Main content */}
      <div class="min-w-0 flex-1 space-y-10">
        {/* Getting Started */}
        <section>
          <h2 class="text-lg font-semibold mb-3">Getting Started</h2>
          <PackageManagerCommand serverId={server.id} />
          <p class="text-xs text-text-secondary mt-2">
            Requires {runtimeToRequirements(server.runtime)}.{" "}
            {
              server.isOfficial
                ? `Official server${server.author ? ` by ${server.author}` : ""}.`
                : "Community-contributed server."
            }{" "}
            <a href="/docs#security-disclaimer" class="text-accent hover:underline"
              >Review source before installing</a
            >.
          </p>
          <div class="mt-3 flex flex-wrap gap-3">
            {
              GUIDE_SLUGS.slice(0, 4).map((slug) => (
                <a href={`/guides/${slug}`} class="text-xs text-accent hover:underline">
                  {slug.replace(/-/g, " ").replace(/\b\w/g, (l) => l.toUpperCase())} guide &rarr;
                </a>
              ))
            }
          </div>
        </section>

        {/* Required env vars */}
        {
          server.requiredEnvVars.length > 0 && (
            <section class="rounded-lg border border-warning-border bg-warning-subtle p-4">
              <h2 class="text-sm font-medium text-warning mb-2">Required Environment Variables</h2>
              <ul class="space-y-2">
                {server.requiredEnvVars.map((envVar) => {
                  const detail = server.envVarDetails?.find((d) => d.name === envVar);
                  return (
                    <li class="text-sm">
                      <div class="flex items-center gap-1.5">
                        <code class="text-warning-light bg-code-bg px-1.5 py-0.5 rounded">
                          {envVar}
                        </code>
                        {detail?.isSecret && (
                          <span class="text-warning-light text-xs" title="Secret value">
                            <Lock class="w-3.5 h-3.5 inline" aria-label="Secret" />
                          </span>
                        )}
                      </div>
                      {detail?.description && (
                        <p class="text-xs text-text-secondary mt-0.5 ml-0.5">
                          {detail.description}
                        </p>
                      )}
                    </li>
                  );
                })}
              </ul>
            </section>
          )
        }

        {/* Config generator */}
        <ConfigViewer configs={configs} />
      </div>

      {/* Sidebar */}
      <aside class="w-full lg:w-72 shrink-0 lg:sticky lg:top-6 lg:self-start">
        <ServerSidebar server={server} metrics={metrics} />
      </aside>
    </div>

    {/* Related servers */}
    {
      relatedServers.length > 0 && (
        <section class="mt-16 pt-10 border-t border-border">
          <h2 class="text-xl font-semibold mb-6">Related Servers</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {relatedServers.map((s) => (
              <ServerCard server={s} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
