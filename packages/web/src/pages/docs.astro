---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { DocsContent } from "@/components/DocsContent";
import { resolveMetadata } from "@/lib/metadata";
import { DOCS_OG } from "@/lib/og-pages";

const metadata = resolveMetadata(
