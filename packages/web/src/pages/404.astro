---
import BaseLayout from "@/layouts/BaseLayout.astro";
import NotFound from "@/components/NotFound.astro";
import { resolveMetadata } from "@/lib/metadata";
import { HOME_OG } from "@/lib/og-pages";

// Root metadata and OG image, noindex.
const metadata = resolveMetadata(
  {},
  { noindex: true, ogImage: { path: "/opengraph-image.png", alt: HOME_OG.alt } },
);
---

<BaseLayout metadata={metadata} preloadSymbols>
  <h1 class="sr-only">404: Page not found</h1>
  <NotFound />
</BaseLayout>
